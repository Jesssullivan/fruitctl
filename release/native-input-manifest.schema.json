{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruitctl.clients.xoxd.ai/schemas/native-input-manifest.schema.json",
  "title": "Fruitctl regenerated native input manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "platform", "architecture", "minimumMacOS", "sourceLockSha256", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "fruitctl-native-inputs"},
    "platform": {"const": "darwin"},
    "architecture": {"const": "arm64"},
    "minimumMacOS": {"const": "15.0"},
    "sourceLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependencyBuildConfiguration": {
      "type": "object",
      "const": {
        "version": 1,
        "architecture": "arm64",
        "minimumMacOS": "15.0",
        "openssl": {
          "prefix": "/opt/fruitctl",
          "openssldir": "/opt/fruitctl/ssl",
          "libdir": "lib",
          "configureOptions": [
            "darwin64-arm64-cc",
            "no-shared",
            "no-module",
            "no-tests"
          ],
          "privateInstallStage": "${BUILD_ROOT}/openssl-stage",
          "compilerFlagsPolicy": "path-free",
          "compilerFlags": [
            "-mmacosx-version-min=15.0"
          ]
        },
        "libvncCompilerPathMapPolicy": {
          "source": "/fruitctl/source",
          "build": "/fruitctl/build",
          "cOptions": [
            "-ffile-prefix-map",
            "-fdebug-prefix-map"
          ]
        },
        "libvncclient": {
          "target": "vncclient",
          "shared": false,
          "tls": "static-openssl"
        }
      }
    },
    "dependencyBuildConfigurationSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {
      "type": "object", "minProperties": 7,
      "additionalProperties": {
        "type": "object", "required": ["sha256", "bytes"], "additionalProperties": false,
        "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}
      }
    }
  },
  "dependentRequired": {
    "dependencyBuildConfiguration": ["dependencyBuildConfigurationSha256"],
    "dependencyBuildConfigurationSha256": ["dependencyBuildConfiguration"]
  },
  "additionalProperties": false
}
