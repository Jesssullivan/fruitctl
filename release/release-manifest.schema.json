{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruitctl.clients.xoxd.ai/schemas/release-manifest.schema.json",
  "title": "Fruitctl release manifest",
  "type": "object",
  "required": ["schema", "version", "repository", "assets"],
  "properties": {
    "schema": {"const": "fruitctl.release.v1"},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "repository": {"const": "xoxd-ai/fruitctl"},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["kind", "name", "url", "sha256"],
        "properties": {
          "kind": {"enum": ["runtime", "source", "native", "evidence"]},
          "os": {"enum": ["darwin", "linux"]},
          "arch": {"enum": ["arm64", "x64"]},
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
          "url": {"type": "string", "pattern": "^https://github\\.com/xoxd-ai/fruitctl/releases/download/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "runtime"}}}, "then": {"required": ["os", "arch"]}}]
      }
    }
  }
}
